---
import BaseLayout from '../../layouts/BaseLayout.astro';
import scheduleData from '../../data/schedule.json';
import genData from '../../data/schedule.gen.json';
import site from '../../data/site.json';
import { EVENT_BODIES } from '../../data/eventBodies';
import { getEventImage } from '../../utils/eventImages';
import { formatVenue } from '../../utils/event';
import { marked } from 'marked';
import EventDetail from '../../components/EventDetail';

export async function getStaticPaths() {
  // 优先消费 D1 生成的种子（src/data/schedule.gen.json，由 scripts/sync-events-seed.cjs
  // 在 prebuild 阶段从 D1 拉取后写入；无 D1 凭据时退回提交版 schedule.json）。
  // 这样后台 admin 新增/修改的 events 在 CF 重建后会成为真正的静态详情页
  // （含灯箱、进 sitemap），不必再依赖 [[path]].js 的 D1 兜底渲染。
  const genEvents = (genData && Array.isArray(genData.events) && genData.events.length)
    ? genData.events
    : scheduleData.events;
  const bodies = (genData && genData.bodies) || {};

  return (genEvents as any[]).map((e) => {
    const bodyText = (bodies[e.id] || EVENT_BODIES[e.id] || '') as string;
    return {
      params: { id: e.id },
      // 构建期预渲染 body 为 HTML，存入 bodyHtml——详情页无需客户端加载 marked（约 40KB），
      // 静态 HTML 直接含正文，零布局跳动。运行时缺失 bodyHtml 时才动态 import marked 兜底。
      props: {
        event: {
          ...e,
          image: e.image || getEventImage(e.id),
          body: bodyText,
          bodyHtml: marked.parse(bodyText, { async: false }) as string,
        },
      },
    };
  });
}

const id = Astro.params.id;
const { event } = Astro.props;

// 活动详情页结构化数据（Event schema），提升搜索结果富媒体展现
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: event.title,
  startDate: event.time ? `${event.date}T${event.time}:00` : event.date,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: new URL(event.image, Astro.site).href,
  description: event.title,
  location: {
    '@type': 'Place',
    name: formatVenue(event.city, event.venue) || '待定',
    address: formatVenue(event.city, event.venue) || '',
  },
  organizer: {
    '@type': 'Organization',
    name: site.name,
    url: Astro.site?.href || 'https://gleams.vip',
  },
};
---

<BaseLayout title={event.title} image={event.image} jsonLd={eventJsonLd}>
  <EventDetail client:load id={id} event={event} />
</BaseLayout>
